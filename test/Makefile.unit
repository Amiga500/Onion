	rm -rf $(BUILD_DIR)/test_str $(BUILD_DIR)/test_perf $(BUILD_DIR)/test_file $(BUILD_DIR)/test_hash $(BUILD_DIR)/test_json $(BUILD_DIR)/test_state $(BUILD_DIR)/test_neon $(BUILD_DIR)/test_playactivity $(BUILD_DIR)/test_clock $(BUILD_DIR)/test_msleep $(BUILD_DIR)/test_config $(BUILD_DIR)/test_log $(BUILD_DIR)/test_flags $(BUILD_DIR)/test_process $(BUILD_DIR)/test_timer $(BUILD_DIR)/test_apply_icons $(BUILD_DIR)/test_settings $(BUILD_DIR)/test_list $(BUILD_DIR)/test_color $(BUILD_DIR)/test_apps $(BUILD_DIR)/test_changes $(BUILD_DIR)/test_gs_history $(BUILD_DIR)/test_has_changed
