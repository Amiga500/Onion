# Makefile.unit - Standalone C unit tests for Onion OS
#
# These tests run on the host machine (x86/arm64) without needing
# the Miyoo Mini cross-compiler, SDL, or Google Test.
#
# Usage:
#   make -f Makefile.unit          # Build and run all tests
#   make -f Makefile.unit test_str # Build and run str tests only
#   make -f Makefile.unit clean    # Remove build artifacts
#
# From the top-level Makefile:
#   make unit-test

CC      ?= gcc
CFLAGS  := -Wall -Wextra -std=c99 -g -I../include -I../src/common \
           -DPLATFORM_LINUX -DONION_VERSION="\"test\"" -D_GNU_SOURCE
LDFLAGS :=

BUILD_DIR := ../build_test

# Source files for common utils (no SDL dependency)
COMMON_SRCS := ../src/common/utils/str.c ../src/common/utils/log.c ../src/common/utils/file.c

# Test targets
TESTS := test_str test_perf test_file test_hash test_json test_state test_neon test_playactivity test_clock test_msleep test_config test_log test_flags test_process test_timer test_apply_icons test_settings test_list test_color test_apps test_changes test_gs_history test_gs_popmenu test_gs_retroarch test_has_changed test_str_security test_file_security test_json_security test_game_entry test_state_security test_config_security test_volume test_display test_lang test_signal_handler test_battery test_playactivity_paths test_theme_config test_device_model test_theme_load test_cache_db test_gs_appstate test_legacy_db test_keymap test_resources_enum test_screenshot_path test_system_utils test_display_buffers test_rom_image_path test_theme_sort test_savestate_path test_overlay_content test_theme_scale test_list_sort test_settings_has_changed test_romscreen_find test_neon_pixel test_formatters test_pacman_changes test_alpha_scale test_osd_constants test_null_safety test_critical_fixes test_cjson_null_safety test_json_null_guards test_double_call_safety test_batmon_flip

# Build-only targets (compilation without running)
BINARIES := $(addprefix $(BUILD_DIR)/, $(TESTS))

.PHONY: all clean $(TESTS) summary

all: $(BINARIES)
	@total_tests=0; total_asserts=0; total_fails=0; \
	summary=""; \
	for t in $(TESTS); do \
		printf "\n"; \
		output=$$($(BUILD_DIR)/$$t 2>&1) && status="PASSED" || status="FAILED"; \
		printf "%s\n" "$$output"; \
		tc=$$(printf "%s\n" "$$output" | grep "Tests:" | head -1 | sed 's/.*Tests: *\([0-9]*\).*/\1/'); \
		ac=$$(printf "%s\n" "$$output" | grep "Assertions:" | head -1 | sed 's/.*Assertions: *\([0-9]*\).*/\1/'); \
		fc=$$(printf "%s\n" "$$output" | grep "Failures:" | head -1 | sed 's/.*Failures: *\([0-9]*\).*/\1/'); \
		total_tests=$$((total_tests + $${tc:-0})); \
		total_asserts=$$((total_asserts + $${ac:-0})); \
		total_fails=$$((total_fails + $${fc:-0})); \
		summary="$$summary$$(printf '  %-34s %6s %11s  %s' "$$t" "$${tc:-0}" "$${ac:-0}" "$$status")\n"; \
	done; \
	printf "\n"; \
	printf "===============================================================\n"; \
	printf "                       UNIT TEST SUMMARY\n"; \
	printf "===============================================================\n"; \
	printf "  %-34s %6s %11s  %s\n" "Suite" "Tests" "Assertions" "Result"; \
	printf "  %-34s %6s %11s  %s\n" "----------------------------------" "------" "-----------" "------"; \
	printf "%b" "$$summary"; \
	printf "  %-34s %6s %11s  %s\n" "----------------------------------" "------" "-----------" "------"; \
	printf "  %-34s %6d %11d\n" "Total" $$total_tests $$total_asserts; \
	printf "\n"; \
	if [ $$total_fails -eq 0 ]; then \
		printf "                      Result: ALL PASSED\n"; \
	else \
		printf "                      Result: SOME TESTS FAILED ($$total_fails failures)\n"; \
	fi; \
	printf "===============================================================\n"; \
	[ $$total_fails -eq 0 ]

