	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -o $@ test_null_safety.c $(COMMON_SRCS) $(LDFLAGS)

test_critical_fixes: $(BUILD_DIR)/test_critical_fixes
	@echo ""
	@$(BUILD_DIR)/test_critical_fixes

$(BUILD_DIR)/test_critical_fixes: test_critical_fixes.c onion_test.h $(COMMON_SRCS)
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -o $@ test_critical_fixes.c $(COMMON_SRCS) $(LDFLAGS)

test_cjson_null_safety: $(BUILD_DIR)/test_cjson_null_safety
	@echo ""
	@$(BUILD_DIR)/test_cjson_null_safety

$(BUILD_DIR)/test_cjson_null_safety: test_cjson_null_safety.c onion_test.h $(COMMON_SRCS) ../include/cjson/cJSON.c
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -o $@ test_cjson_null_safety.c $(COMMON_SRCS) ../include/cjson/cJSON.c $(LDFLAGS) -lm

test_json_null_guards: $(BUILD_DIR)/test_json_null_guards
	@echo ""
	@$(BUILD_DIR)/test_json_null_guards

$(BUILD_DIR)/test_json_null_guards: test_json_null_guards.c onion_test.h $(COMMON_SRCS) ../include/cjson/cJSON.c
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -o $@ test_json_null_guards.c $(COMMON_SRCS) ../include/cjson/cJSON.c $(LDFLAGS) -lm

test_double_call_safety: $(BUILD_DIR)/test_double_call_safety
	@echo ""
	@$(BUILD_DIR)/test_double_call_safety

$(BUILD_DIR)/test_double_call_safety: test_double_call_safety.c onion_test.h
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -o $@ test_double_call_safety.c $(LDFLAGS)

# Host ASan/UBSan on the leaf utils that compile without SDL.
# Ubuntu CI gcc ships libasan. Fedora hosts may only have clang's compiler-rt;
# detect a compiler that can actually link the sanitizers.
SANITIZE_FLAGS := -fsanitize=address,undefined

unit-test-san:
	@mkdir -p $(BUILD_DIR)
	@probe="$(BUILD_DIR)/_san_probe"; \
	if echo 'int main(void){return 0;}' | $(CC) $(SANITIZE_FLAGS) -x c - -o $$probe 2>/dev/null; then \
		SAN_CC="$(CC)"; \
	elif echo 'int main(void){return 0;}' | clang $(SANITIZE_FLAGS) -x c - -o $$probe 2>/dev/null; then \
		SAN_CC="clang"; \
	else \
		echo "No compiler with ASan/UBSan (install gcc libasan or clang)"; \
		exit 1; \
	fi; \
	rm -f $$probe; \
	echo "Sanitizer subset ($$SAN_CC $(SANITIZE_FLAGS)): hash file str json neon"; \
	$$SAN_CC $(CFLAGS) $(SANITIZE_FLAGS) -o $(BUILD_DIR)/test_hash_san test_hash.c $(LDFLAGS) && \
	$$SAN_CC $(CFLAGS) $(SANITIZE_FLAGS) -o $(BUILD_DIR)/test_file_san test_file.c $(COMMON_SRCS) $(LDFLAGS) && \
	$$SAN_CC $(CFLAGS) $(SANITIZE_FLAGS) -o $(BUILD_DIR)/test_str_san test_str.c $(COMMON_SRCS) $(LDFLAGS) && \
	$$SAN_CC $(CFLAGS) $(SANITIZE_FLAGS) -o $(BUILD_DIR)/test_json_san test_json.c $(COMMON_SRCS) ../include/cjson/cJSON.c $(LDFLAGS) && \
	$$SAN_CC $(CFLAGS) $(SANITIZE_FLAGS) -o $(BUILD_DIR)/test_neon_san test_neon.c $(LDFLAGS)
	@fail=0; \
	for t in test_hash test_file test_str test_json test_neon; do \
		printf "\n"; \
		$(BUILD_DIR)/$${t}_san || fail=1; \
	done; \
	[ $$fail -eq 0 ]

# Cross-compile neon_pixel.h / surfaceSetAlpha.h with NEON and run under qemu-arm.
# Host `make unit-test` stays x86-only. This target is required in CI (job neon-arm).
ARM_CC   ?= $(shell command -v arm-linux-gnueabihf-gcc 2>/dev/null || command -v arm-linux-gnu-gcc 2>/dev/null)
QEMU_ARM ?= $(shell command -v qemu-arm-static 2>/dev/null || command -v qemu-arm 2>/dev/null)
ARM_CFLAGS := $(CFLAGS) -std=gnu99 -static -O1 -marm -mfpu=neon -mfloat-abi=hard \
              -march=armv7-a -DNEON_TEST_COMPARE

unit-test-neon-arm neon-test-arm:
	@if [ -z "$(ARM_CC)" ]; then \
		echo "unit-test-neon-arm: FAIL: no ARM cross compiler."; \
		echo "  Install gcc-arm-linux-gnueabihf (Debian/Ubuntu) or gcc-arm-linux-gnu (Fedora)."; \
		exit 1; \
	fi
	@if [ -z "$(QEMU_ARM)" ]; then \
		echo "unit-test-neon-arm: FAIL: qemu-arm / qemu-arm-static not found."; \
		echo "  Install qemu-user-static."; \
		exit 1; \
	fi
	@mkdir -p $(BUILD_DIR)
	@echo "NEON ARM tests: $(ARM_CC) + $(QEMU_ARM)"
	$(ARM_CC) $(ARM_CFLAGS) -o $(BUILD_DIR)/test_neon_arm test_neon.c
	$(ARM_CC) $(ARM_CFLAGS) -o $(BUILD_DIR)/test_neon_pixel_arm test_neon_pixel.c
	$(ARM_CC) $(ARM_CFLAGS) -Istubs -o $(BUILD_DIR)/test_alpha_scale_arm test_alpha_scale.c
	@fail=0; \
	for t in test_neon_arm test_neon_pixel_arm test_alpha_scale_arm; do \
		printf "\n--- qemu-arm %s ---\n" "$$t"; \
		$(QEMU_ARM) $(BUILD_DIR)/$$t || fail=1; \
	done; \
	[ $$fail -eq 0 ]

clean:
	rm -f $(addprefix $(BUILD_DIR)/, $(TESTS)) \
		$(BUILD_DIR)/test_hash_san $(BUILD_DIR)/test_file_san \
		$(BUILD_DIR)/test_str_san $(BUILD_DIR)/test_json_san \
		$(BUILD_DIR)/test_neon_san $(BUILD_DIR)/test_images_browser \
		$(BUILD_DIR)/_san_probe \
		$(BUILD_DIR)/test_neon_arm $(BUILD_DIR)/test_neon_pixel_arm \
		$(BUILD_DIR)/test_alpha_scale_arm
