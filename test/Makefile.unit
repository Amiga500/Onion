	$(CC) $(CFLAGS) -o $@ test_hash.c $(LDFLAGS)

$(BUILD_DIR)/test_json: test_json.c onion_test.h $(COMMON_SRCS)
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -o $@ test_json.c $(COMMON_SRCS) ../include/cjson/cJSON.c $(LDFLAGS)

