#!/bin/sh
# OPEN_MAINUI_WRAPPER - generated by src/openMainUI/install.sh for @VARIANT@.
#
# Runs Open MainUI in the Onion MainUI slot and falls back to the original
# @VARIANT@ binary when:
#   - .tmp_update/mainui-test/DISABLED exists (manual switch);
#   - the Open MainUI binary is missing or not executable.
#
# exec keeps the process named MainUI for keymon. The arguments match
# Open MainUI's own device/MainUI-test-wrapper.sh. Logging is best effort:
# a read-only or full card never stops the launcher from starting.
sd=/mnt/SDCARD
sysdir="$sd/.tmp_update"
testdir="$sysdir/mainui-test"
stock="$testdir/stock/@VARIANT@"
open="$testdir/MainUI"

cd "$sd/miyoo/app" 2> /dev/null

if [ -f "$testdir/DISABLED" ] || [ ! -x "$open" ]; then
    if [ -x "$stock" ]; then
        exec "$stock"
    fi
    # No stock copy left: Open MainUI is better than no launcher at all.
    [ -x "$open" ] || { sleep 5; exit 1; }
fi

export LD_LIBRARY_PATH="$sysdir/lib:$sd/miyoo/lib:/config/lib:/lib"

if [ -f "$sysdir/config/.logging" ] && mkdir -p "$sysdir/logs" 2> /dev/null; then
    log="$sysdir/logs/MainUI.log"
    bytes=$(wc -c < "$log" 2> /dev/null)
    case "$bytes" in '' | *[!0-9]*) bytes=0 ;; esac
    if [ "$bytes" -ge 1048576 ]; then
        mv -f "$log" "$log.1" 2> /dev/null
    fi
    if { echo "--- MainUI start $(date '+%Y-%m-%d %H:%M:%S') (@VARIANT@) ---" >> "$log"; } 2> /dev/null; then
        exec "$open" --sd-root "$sd" --device real --handoff-dir /tmp >> "$log" 2>&1
    fi
fi
exec "$open" --sd-root "$sd" --device real --handoff-dir /tmp > /dev/null 2>&1
