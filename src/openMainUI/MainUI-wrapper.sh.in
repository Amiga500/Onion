#!/bin/sh
# OPEN_MAINUI_WRAPPER - generated by src/openMainUI/install.sh for @VARIANT@.
#
# Runs Open MainUI in the Onion MainUI slot and falls back to the original
# @VARIANT@ binary when:
#   - .tmp_update/mainui-test/DISABLED exists (manual switch);
#   - the Open MainUI binary is missing or not executable;
#   - Open MainUI failed twice in a row before drawing its first frame
#     (fallback lasts until the next reboot, so a fixed card retries).
#
# exec keeps the process named MainUI for keymon. Logging is best effort:
# a read-only or full card never stops the launcher from starting.
sd=${OPEN_MAINUI_SD:-/mnt/SDCARD}
tmp=${OPEN_MAINUI_TMP:-/tmp}
sysdir="$sd/.tmp_update"
testdir="$sysdir/mainui-test"
stock="$testdir/stock/@VARIANT@"
open="$testdir/MainUI"
marker="$tmp/open-mainui.starting"
fails_file="$tmp/open-mainui.fails"
fallback="$tmp/open-mainui.fallback"

note() {
    [ -f "$sysdir/config/.logging" ] || return 0
    { echo "$(date '+%Y-%m-%d %H:%M:%S') [open-mainui wrapper] $*" >> "$sysdir/logs/MainUI.log"; } 2> /dev/null
}

run_stock() {
    if [ -x "$stock" ]; then
        exec "$stock"
    fi
    note "stock backup missing: $stock"
    if [ -x "$open" ]; then
        # Last resort: better than no launcher at all.
        rm -f "$fallback" 2> /dev/null
        return 0
    fi
    # Nothing runnable. Slow down Onion's relaunch loop instead of spinning.
    sleep 5
    exit 1
}

cd "$sd/miyoo/app" 2> /dev/null

# A marker still present means the previous start never drew a frame.
fails=0
if [ -f "$marker" ]; then
    fails=$(cat "$fails_file" 2> /dev/null)
    case "$fails" in '' | *[!0-9]*) fails=0 ;; esac
    fails=$((fails + 1))
fi
echo "$fails" > "$fails_file" 2> /dev/null
if [ "$fails" -ge 2 ] && [ ! -f "$fallback" ]; then
    : > "$fallback" 2> /dev/null
    note "Open MainUI failed $fails starts in a row; using stock until reboot"
fi

if [ -f "$testdir/DISABLED" ] || [ ! -x "$open" ] || [ -f "$fallback" ]; then
    rm -f "$marker" 2> /dev/null
    run_stock
fi

export LD_LIBRARY_PATH="$sysdir/lib:$sd/miyoo/lib:/config/lib:/lib"
export MAINUI_START_MARKER="$marker"
: > "$marker" 2> /dev/null

if [ -f "$sysdir/config/.logging" ] && mkdir -p "$sysdir/logs" 2> /dev/null; then
    log="$sysdir/logs/MainUI.log"
    bytes=$(wc -c < "$log" 2> /dev/null)
    case "$bytes" in '' | *[!0-9]*) bytes=0 ;; esac
    if [ "$bytes" -ge 1048576 ]; then
        mv -f "$log" "$log.1" 2> /dev/null
    fi
    if { echo "--- MainUI start $(date '+%Y-%m-%d %H:%M:%S') (@VARIANT@) ---" >> "$log"; } 2> /dev/null; then
        exec "$open" --sd-root "$sd" --device real --handoff-dir "$tmp" >> "$log" 2>&1
    fi
fi
exec "$open" --sd-root "$sd" --device real --handoff-dir "$tmp" > /dev/null 2>&1
