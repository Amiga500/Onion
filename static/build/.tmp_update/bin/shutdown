#!/bin/sh

# Not to be killed with the tasks that use the card: this script, and its
# safety net with the sleep it waits in. They can still hold a file of the
# card inherited from the caller, and the safety net killed would restart
# the device in the middle of the clean shutdown.
spared() { # pid
	[ "$1" = "$$" ] && return 0
	[ -n "$safety_pid" ] || return 1
	[ "$1" = "$safety_pid" ] && return 0
	_st=$(cat "/proc/$1/stat" 2> /dev/null) || return 1
	_st=${_st##*) } # after the command name, which may hold spaces
	set -- $_st     # state, parent
	[ "$2" = "$safety_pid" ]
}

task_killer() {
	r=0
	for p in $1; do
		if [ -d "/proc/$p" ] && ! spared "$p"; then
			kill $2 $p
			r=1
		fi
	done
	return $r
}

kill_hooked_tasks() {
	c=0
	while [ $c -lt 5 ]; do
		pids=$(fuser -m /mnt/SDCARD)
		if task_killer "$pids" $1; then
			return
		fi
		sleep 0.05
		c=$((c + 1))
	done
}

# Last resort when the clean shutdown does not finish: flush and try to
# leave the card read-only (marked clean), giving that 5 s in the background
# as the card itself may be what is stuck, then restart or power off at
# once. -f skips init.
force_off() { # $1: -r to restart
	(
		sync
		mount -o remount,ro /mnt/SDCARD
	) < /dev/null > /dev/null 2>&1 &
	sleep 5
	if [ "$1" = "-r" ] || [ "$(cat /tmp/deviceModel 2> /dev/null)" = "283" ]; then
		/sbin/reboot -f
	else
		/sbin/poweroff -f
	fi
}

if [ "$0" = "/tmp/_shutdown" ]; then

	# Off the SD card: the steps below unmount it, and a child left in a
	# folder of the card would be killed with the tasks that use it.
	cd /

	# What is done, with the time, in logs/shutdown.log: a reboot that
	# hangs shows where. Each mark is synced, as the next step may be the
	# last one that reaches the card.
	slog=/mnt/SDCARD/.tmp_update/logs/shutdown.log
	mark() {
		echo "$(date +%H:%M:%S) $*" >> "$slog" 2> /dev/null
		sync
	}
	# The previous one is kept: after a forced restart, the next shutdown
	# does not wipe what the stuck one logged.
	[ -f "$slog" ] && mv -f "$slog" "${slog%.log}.prev.log" 2> /dev/null
	: > "$slog" 2> /dev/null
	mark "start $1 (model $(cat /tmp/deviceModel 2> /dev/null))"

	# Safety net: whatever hangs below (a process that won't die, swapoff,
	# init), the device restarts or powers off by itself after 30 s instead
	# of staying on the last screen until POWER is held.
	safety_wait=30
	(
		sleep "$safety_wait"
		mark "still running after ${safety_wait} s: forced" &
		force_off "$1"
	) < /dev/null > /dev/null 2>&1 &
	safety_pid=$!

	killall -9 main # mandatory to avoid the suppression of .tmp_update !
	killall -9 updater
	killall -9 runtime.sh
	killall -9 smbd

	mark "stopping the tasks that use the card"
	kill_hooked_tasks
	sleep 0.1
	kill_hooked_tasks -9

	sync
	mark "tasks stopped, synced; still using the card: $(fuser -m /mnt/SDCARD 2> /dev/null | tr -s ' ' ' ')"

	if [ -f /mnt/SDCARD/system.json ]; then
		mkdir -p /mnt/SDCARD/.tmp_update/config/system
		mv -f /mnt/SDCARD/system.json "/mnt/SDCARD/.tmp_update/config/system/$(read_uuid).json"
		sync
	fi

	rm -f /appconfigs/system.json 2> /dev/null
	rm -f /mnt/SDCARD/update.log 2> /dev/null

	umount /etc/passwd /etc/group /etc/profile
	umount /mnt/SDCARD/miyoo/app/MainUI
	umount /mnt/SDCARD/RetroArch/retroarch
	umount /customer/lib/libgamename.so
	mark "swapoff"
	swapoff /mnt/SDCARD/cachefile
	mark "unmounting the card"
	umount -r /mnt/SDCARD
	umount /mnt/SDCARD

	############# DEBUG #############
	# fuser -m /mnt/SDCARD > /appconfigs/shutdown.log
	# lsof /mnt/SDCARD >> /appconfigs/shutdown.log
	# mount >> /appconfigs/shutdown.log
	#################################

	if [ "$1" = "-r" ]; then
		/sbin/reboot
	else
		if [ "$(cat /tmp/deviceModel)" = "283" ]; then
			/sbin/reboot # no poweroff command on Miyoo Mini
		else
			/sbin/poweroff
		fi
	fi

	# reboot and poweroff hand over to init, which stops this script. Not
	# on to the caller's part below: the safety net covers until then.
	while true; do
		sleep 10
	done
fi

if [ ! -f /tmp/_shutdown ]; then
	cp -f "$0" /tmp/_shutdown
fi

# run the script totally detached from current shell
pgrep -f /tmp/_shutdown || (
	set -m
	su root -c "/usr/bin/nohup /tmp/_shutdown $1 </dev/null >/dev/null 2>&1 &"
)

# The detached part stops this caller with the other tasks that use the
# card, within a second or two. Still here after 45 s: it never started (su)
# or it is stuck before its own safety net, so restart or power off anyway.
caller_wait=45
sleep "$caller_wait"
force_off "$1"
while true; do
	sleep 10
done
