#!/bin/sh
echo $0 $*
appdir=`cd -- "$(dirname "$0")" >/dev/null 2>&1; pwd -P`
sysdir=/mnt/SDCARD/.tmp_update

if [ ! -d "$appdir/.tmp_update" ] || [ ! -f "$appdir/.tmp_update/install.sh" ] || [ ! -f "$appdir/.tmp_update/onion.pak" ]; then
    # Cancel installation if files are missing
    rm -- "$0"
    reboot
    sleep 10
    # Never go on: below, the installed system is removed
    exit 1
fi

if [ -d $sysdir ]; then
    cd $sysdir

    # Move romScreens to new location
    mkdir -p /mnt/SDCARD/Saves/CurrentProfile/romScreens
    mv ./romScreens/* /mnt/SDCARD/Saves/CurrentProfile/romScreens/

    if [ -f ./bin/installUI ]; then
        mkdir -p onionVersion
        ./bin/installUI --version > ./onionVersion/previous_version.txt
    fi

    # Remove old system files, except onionVersion, config and etc (SSH host keys)
    find * -maxdepth 0 -not -name "onionVersion" -not -name "config" -not -name "etc" -exec rm -rf {} \;

    # Move dotfiles to new location
    mkdir -p config
    mv .* config/
fi

# Move installation files
cd $appdir
mkdir -p $sysdir
mv .tmp_update/* $sysdir

cd $sysdir
./updater

# install.sh reboots through the clean shutdown (bin/shutdown -r, copied to
# /tmp/_shutdown), which kills updater first: this script went on at once
# to its own plain reboot, a few ms later, before the shutdown had saved
# system.json and unmounted the card, so the FAT stayed dirty after every
# installation. Leave the reboot to it: it kills this script soon after
# (its folder is on the card). Without it (a failed installation reboots
# plainly), reboot as before.
[ -f /tmp/_shutdown ] && sleep 30
reboot
sleep 10
